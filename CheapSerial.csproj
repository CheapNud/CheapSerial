<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet -->
    <PackageId>CheapSerial</PackageId>
    <Version>1.0.0</Version>
    <Authors>CheapNud</Authors>
    <Description>A no-nonsense serial port library for .NET: async reads and writes that respect timeouts and cancellation tokens, with automatic reconnection and DI-friendly configuration.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CheapNud/CheapSerial</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CheapNud/CheapSerial</RepositoryUrl>
    <PackageTags>serial serialport com rs232 uart async cancellation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nested test project must not be globbed into the library -->
    <Compile Remove="CheapSerial.Tests\**" />
    <InternalsVisibleTo Include="CheapSerial.Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
  </ItemGroup>

</Project>
